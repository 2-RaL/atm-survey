# Hostinger hPanel → Node.js Web App → Environment Variables
# VACİB: Bu fayl serverə .env kimi yüklənməməlidir; hPanel-də təyin edin.
NODE_ENV=production
HOST=0.0.0.0
# PORT Hostinger tərəfindən verildikdə onu dəyişməyin.
# PORT=3000
ADMIN_USERNAME=admin
# Aşağıdakı sətri öz unikal, ən az 12 simvolluq şifrənizlə əvəz edin və hPanel-ə daxil edin:
# ADMIN_PASSWORD=<strong-random-unique-password>
SEED_DEMO=false
# Qalıcı data qovluğu (hbuilds və public_html-dən KƏNAR):
# DATA_DIR=/home/USER/domains/DOMAIN/sorgupro-private-data
# DATA_DIR verilməsə, Hostinger qovluq quruluşu aşkar ediləndə avtomatik təyin olunur.
